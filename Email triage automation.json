    {
      "parameters": {
        "jsCode": "// Gemini ka sara data string bana kar direct JSON object nikalna\nconst inputObj = $input.first().json;\n\n// Gemini ke mukhtalif structures ko safely target karein:\nlet textContent = \n  inputObj.parts?.[1]?.text || \n  inputObj.parts?.[0]?.text || \n  inputObj.content?.parts?.[1]?.text || \n  inputObj.content?.parts?.[0]?.text || \n  inputObj.candidates?.[0]?.content?.parts?.[0]?.text ||\n  JSON.stringify(inputObj);\n\n// Regex se '{' se lekar '}' tak ka saaf JSON nikal lein\nconst jsonMatch = textContent.match(/\\{[\\s\\S]*\\}/);\n\nif (jsonMatch) {\n  return JSON.parse(jsonMatch[0]);\n} else {\n  throw new Error(\"No JSON found in text: \" + textContent);\n}"
      },
